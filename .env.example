# Groq API for Vietnamese topic/script/SEO generation.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Pexels stock-video search/download.
PEXELS_API_KEY=your_pexels_api_key

# Vietnamese Edge-TTS voice (optional).
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# YouTube Data API OAuth: only required when AUTO_PUBLISH=true.
# Never commit real credentials.
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
AUTO_PUBLISH=false
SCHEDULE_MINUTES_AHEAD=60
